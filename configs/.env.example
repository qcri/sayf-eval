# API credentials for the model-under-test and/or the judge.
# LiteLLM reads provider keys from the environment by convention.

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Azure OpenAI (set base via --base-url or AZURE_API_BASE)
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=2024-12-01-preview

# Local vLLM server (OpenAI-compatible). Point LiteLLM at it with
#   --model openai/<served-name> --base-url http://localhost:8000/v1
# A dummy key is fine for most local servers.
VLLM_API_KEY=EMPTY
